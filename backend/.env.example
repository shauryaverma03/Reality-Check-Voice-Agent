# Optional. If unset, extraction falls back to a heuristic regex parser for
# voice claims and presence-only handling for photos — the whole pipeline
# still runs end-to-end without a key.
ANTHROPIC_API_KEY=

PORT=3001

# Optional. Where the SQLite DB and uploaded evidence files live. Defaults
# to backend/data if unset — fine for local dev, but on a real deploy this
# should point at a mounted persistent volume (the filesystem most hosts
# give you is otherwise wiped on every redeploy). See README's Deployment
# section.
DATA_DIR=
